*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments and local dependency folders
venv/
.venv/
env/
ENV/

# Local environment and secrets
.env
.env.*
!.env.example
data/.credentials.json

